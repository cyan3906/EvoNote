APP_NAME=Evonote API
APP_ENV=development
APP_DEBUG=true
HOST=127.0.0.1
PORT=8000

# Agent API
AGENT_API_BASE_URL=http://127.0.0.1:9000
AGENT_API_KEY=your-agent-api-key
AGENT_MODEL=default-agent
AGENT_TIMEOUT_SECONDS=30

# Auth
AUTH_PASSWORD=evonote2026
AUTH_TOKEN=replace-with-a-long-random-token

# SQLite
SQLITE_DATABASE_PATH=data/evonote.sqlite3

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=3600
