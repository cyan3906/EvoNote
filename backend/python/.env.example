APP_NAME=Evonote API
APP_ENV=development
APP_DEBUG=true
HOST=127.0.0.1
PORT=8000

# Agent API
AGENT_API_BASE_URL=https://api.uiuihao.com/v1
AGENT_API_KEY=your-agent-api-key
AGENT_MODEL=gpt-4o-mini
AGENT_TIMEOUT_SECONDS=30

# Evolution LLM
# Defaults to the Agent API values when left empty.
EVOLUTION_API_BASE_URL=https://api.uiuihao.com/v1
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_MODEL=
EVOLUTION_TIMEOUT_SECONDS=0
EVOLUTION_TEMPERATURE=0

# Embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5
EMBEDDING_CIRCUIT_COOLDOWN_SECONDS=30

# Hybrid retrieval
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=
MILVUS_COLLECTION=evonote_claims
ES_URL=http://127.0.0.1:9200
ES_INDEX=evonote_claims
RETRIEVAL_TOP_K=20
RRF_K=60
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_DELAY_SECONDS=0.5
EXTERNAL_RETRY_MAX_DELAY_SECONDS=4.0

# Auth
AUTH_PASSWORD=evonote2026
AUTH_TOKEN=replace-with-a-long-random-token

# SQLite
SQLITE_DATABASE_PATH=data/evonote.sqlite3

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=3600
